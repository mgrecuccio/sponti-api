      "UpdateContactRequest": {
        "type": "object",
        "description": "Update Contact request payload",
        "properties": {
          "nickName": {
            "type": "string",
            "example": "nickName",
            "maxLength": 100,
            "minLength": 0
          },
          "favorite": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "nickName"
        ]
      },
      "ContactView": {
        "type": "object",
        "description": "Contact relationship visible to the authenticated user.",
        "properties": {
          "contactUserId": {
            "type": "integer",
            "format": "int64",
            "description": "Internal id of the contact user.",
            "example": 24
          },
          "nickName": {
            "type": "string",
            "description": "User-defined nickname for this contact.",
            "example": "Gym buddy"
          },
          "favorite": {
            "type": "boolean",
            "description": "Whether this contact is marked as favorite.",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when this contact relationship was created.",
            "example": "2026-06-12T12:00:00Z"
          }
        }
      },
      "UpdateAvailabilityRuleRequest": {
        "type": "object",
        "description": "Update Availability Rule request payload",
        "properties": {
          "dayOfWeek": {
            "type": "string",
            "enum": [
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY",
              "SUNDAY"
            ],
            "example": "MONDAY"
