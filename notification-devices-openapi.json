          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Authenticated user's internal id.",
            "example": 42
          },
          "phoneNumber": {
            "type": "string",
            "description": "Authenticated user's E.164 phone number.",
            "example": "+32468009911"
          },
          "displayName": {
            "type": "string",
            "description": "Display name shown to contacts and invitations.",
            "example": "Marco"
