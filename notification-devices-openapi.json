{
  "openapi": "3.1.0",
  "info": {
    "title": "Sponti API",
    "description": "Private social matching API for Sponti.\n\nContract notes for mobile clients:\n- DTO field names are stable within v1.\n- Errors use RFC 9457 ProblemDetail JSON plus stable `code` and `path` properties.\n- Clients should branch on `code`, not on localized or human-readable `detail`.\n",
    "contact": {
      "name": "MGR Tech"
    },
    "license": {
      "name": "Proprietary"
    },
    "version": "v1"
  },
