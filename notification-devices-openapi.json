          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "channelType": {
            "type": "string",
            "enum": [
              "CHAT",
              "CALL"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegisterDeviceTokenRequest": {
        "type": "object",
        "description": "Register notification device token request payload",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "IOS",
              "ANDROID"
            ],
            "example": "ANDROID"
          },
          "token": {
            "type": "string",
            "example": "token",
            "minLength": 1
          },
          "deviceId": {
            "type": "string",
            "example": "device-1",
            "maxLength": 120,
            "minLength": 0
          },
          "appVersion": {
            "type": "string",
            "example": "1.0",
            "maxLength": 60,
            "minLength": 0
          }
        },
        "required": [
          "platform",
          "token"
        ]
      },
      "CreateMatchRequest": {
        "type": "object",
        "properties": {
          "candidateUserId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "channelType": {
            "type": "string",
            "enum": [
              "CHAT",
              "CALL"
            ],
            "example": "CHAT"
          }
        },
        "required": [
          "candidateUserId",
          "channelType"
        ]
      },
      "MatchView": {
        "type": "object",
        "description": "Match proposal response.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Match proposal id.",
            "example": 51
          },
          "candidateUserId": {
            "type": "integer",
            "format": "int64",
            "description": "Internal candidate user id.",
            "example": 24
          },
          "channelType": {
            "type": "string",
            "description": "Requested communication channel.",
            "enum": [
              "CHAT",
              "CALL"
            ],
            "example": "CHAT"
          },
          "status": {
            "type": "string",
            "description": "Proposal status.",
            "example": "PROPOSED"
          },
          "score": {
            "type": "integer",
            "format": "int32",
            "description": "Match score used when creating the proposal.",
            "example": 120
          },
          "overlapStart": {
            "type": "string",
            "format": "date-time",
            "description": "Start of overlapping availability.",
            "example": "2026-06-12T12:00:00Z"
          },
          "overlapEnd": {
            "type": "string",
            "format": "date-time",
            "description": "End of overlapping availability.",
            "example": "2026-06-12T12:30:00Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Proposal creation timestamp.",
            "example": "2026-06-12T11:55:00Z"
          },
          "respondedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when candidate accepted or declined.",
            "example": "2026-06-12T12:01:00Z"
          }
        }
      },
