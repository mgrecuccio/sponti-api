        "properties": {
          "allowChat": {
            "type": "boolean",
            "example": true
          },
          "allowCall": {
            "type": "boolean",
            "example": true
          },
          "quietHoursStart": {
            "type": "string",
            "example": "09:00:00"
          },
          "quietHoursEnd": {
            "type": "string",
            "example": "11:00:00"
          },
          "pushNotificationsEnabled": {
            "type": "boolean",
            "example": true
          },
          "suggestionNotificationsEnabled": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "allowCall",
          "allowChat",
          "pushNotificationsEnabled",
          "suggestionNotificationsEnabled"
        ]
      },
      "UserMatchingPreferencesView": {
