      "SuggestedMatchView": {
        "type": "object",
        "description": "Suggested match candidate for the authenticated user.",
        "properties": {
          "candidateUserId": {
            "type": "integer",
            "format": "int64",
            "description": "Internal id of the suggested candidate user.",
            "example": 24
          },
          "nickName": {
            "type": "string",
            "description": "Authenticated user's nickname for this contact.",
            "example": "Gym buddy"
          },
          "favorite": {
            "type": "boolean",
            "description": "Whether the candidate is marked favorite by the authenticated user.",
            "example": true
