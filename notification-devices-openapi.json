          "startTime": {
            "type": "string",
            "example": "09:00:00"
          },
          "endTime": {
            "type": "string",
            "example": "12:00:00"
          },
          "channelType": {
            "type": "string",
            "enum": [
              "CHAT",
              "CALL"
            ],
            "example": "CHAT"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "channelType",
          "dayOfWeek",
          "enabled",
          "endTime",
          "startTime"
        ]
      },
      "AvailabilityRuleView": {
        "type": "object",
